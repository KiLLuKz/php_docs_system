{
    "name": "doc-system/backend",
    "description": "Document Download System API",
    "type": "project",
    "require": {
        "php": ">=8.2",
        "bramus/router": "~1.6",
        "firebase/php-jwt": "^6.10",
        "vlucas/phpdotenv": "^5.6"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "config": {
        "policy": {
            "advisories": {
                "ignore": {
                    "firebase/php-jwt": "*"
                }
            }
        }
    }
}
